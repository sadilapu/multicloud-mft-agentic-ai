<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mft</groupId>
    <artifactId>multicloud-mft-agentic-ai</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Multi-Cloud Managed File Transfer System with Agentic AI/ML Orchestration</name>
    <description>
        Reference, open-source implementation of a multi-cloud managed file transfer (MFT)
        system that integrates agentic artificial intelligence and machine learning
        orchestration for autonomous cyber-threat detection and defense during file transfer
        operations across heterogeneous cloud infrastructures.
    </description>
    <url>https://github.com/YOUR_GITHUB_USERNAME/multicloud-mft-agentic-ai</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.1</junit.version>
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <dependencies>
        <!-- Test-only dependency. The main application has ZERO external runtime
             dependencies: it uses only the JDK (java.security, javax.crypto,
             com.sun.net.httpserver), so it builds and runs with nothing more
             than a JDK 21 install. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>multicloud-mft-agentic-ai</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.mft.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
